# ========================================================
# Hermes-Clawdbot Environment Configuration
# ========================================================

# --- System & Runtime ---
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# --- Temporal.io Durable Workflow Engine ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hermes-clawdbot-queue

# --- Sandbox Orchestration (Firecracker / E2B / Docker) ---
SANDBOX_PROVIDER=e2b # e2b | firecracker | docker
E2B_API_KEY=your_e2b_api_key_here
FIRECRACKER_SOCKET_PATH=/tmp/firecracker.socket
FIRECRACKER_KERNEL_IMAGE=/var/lib/firecracker/vmlinux.bin
FIRECRACKER_ROOTFS_IMAGE=/var/lib/firecracker/rootfs.ext4
SANDBOX_TIMEOUT_MS=1800000 # 30 minutes max sandbox lifetime

# --- Dynamic Model Router & LLM Gateway ---
LITELLM_PROXY_URL=http://localhost:4000
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Model Assignments
MODEL_TIER1_FAST=anthropic/claude-3-5-haiku-20241022
MODEL_TIER2_REASONING=anthropic/claude-3-5-sonnet-20241022
MODEL_TIER2_DEEP_REASONING=deepseek/deepseek-r1

# Cost & Safety Guardrails
MAX_TOKENS_PER_TASK=500000
TASK_BUDGET_LIMIT_USD=5.00
CONTEXT_COMPACTION_THRESHOLD=0.75 # Trigger compaction at 75% context capacity

# --- Vector Memory & Storage ---
DATABASE_URL=postgresql://hermes_user:hermes_password@localhost:5432/hermes_clawdbot
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=hermes_code_memory

# --- Multi-Platform Gateway Bots ---
# Slack Bot Configuration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_APP_TOKEN=xapp-your-slack-app-token

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here

# --- Evaluation & Benchmarking ---
SWE_BENCH_DATASET_PATH=./packages/eval-suite/data/benchmarks.json
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=hermes-clawdbot
